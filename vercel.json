{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "victor.iepi.consulting" }
      ],
      "destination": "/consultoria/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "instrumentos.iepi.consulting" }
      ],
      "destination": "/instrumentos/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/home/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/(consultoria|instrumentos|home|assets)/.*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
